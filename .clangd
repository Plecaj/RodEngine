CompileFlags:
  CompilationDatabase: build/clang
  Add: [-w]
Diagnostics:
  ClangTidy:
    FastCheckFilter: Strict
  UnusedIncludes: Strict
  MissingIncludes: None
  Includes:
    IgnoreHeader: ['(^|[/\\])rdpch\.h$']
---
If:
  PathMatch: ['RodEngine/vendor/.*', 'build/.*', 'out/.*']
Diagnostics:
  Suppress: '*'
Index:
  Background: Skip
