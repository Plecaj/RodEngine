{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "cacheVariables": {
        "ROD_CXX_STANDARD": "23",
        "BUILD_TESTING": "ON",
        "ROD_BUILD_EDITOR": "ON",
        "ROD_BUILD_LAUNCHER": "ON",
        "ROD_BUILD_RUNTIME": "ON"
      }
    },
    {
      "name": "clang-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/clang",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "analysis-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/analysis",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "vs",
      "displayName": "Windows / MSVC",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "toolset": "host=x64",
      "binaryDir": "${sourceDir}/build/vs",
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": "Windows",
          "intelliSenseMode": "windows-msvc-x64",
          "enableMicrosoftCodeAnalysis": true,
          "intelliSenseOptions": {
            "useCompilerDefaults": true
          }
        }
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-clang",
      "displayName": "Windows / Clang",
      "inherits": "clang-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl"
      }
    },
    {
      "name": "linux-clang",
      "displayName": "Linux / Clang",
      "inherits": "clang-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "GLFW_BUILD_X11": "ON",
        "GLFW_BUILD_WAYLAND": "OFF"
      }
    },
    {
      "name": "windows-clang-analysis",
      "displayName": "Windows / Clang Debug Analysis",
      "inherits": [
        "analysis-base",
        "windows-clang"
      ]
    },
    {
      "name": "linux-clang-analysis",
      "displayName": "Linux / Clang Debug Analysis",
      "inherits": [
        "analysis-base",
        "linux-clang"
      ]
    },
    {
      "name": "linux-clang-sanitizers",
      "displayName": "Linux / Clang ASan + LSan + UBSan",
      "inherits": "linux-clang-analysis",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "ROD_ENABLE_SANITIZERS": "ON"
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1",
        "LSAN_OPTIONS": "exitcode=23:suppressions=${sourceDir}/cmake/lsan.supp"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs-debug",
      "configurePreset": "vs",
      "configuration": "Debug"
    },
    {
      "name": "vs-release",
      "configurePreset": "vs",
      "configuration": "Release"
    },
    {
      "name": "vs-tests",
      "inherits": "vs-debug",
      "targets": [
        "RodEngineTests"
      ]
    },
    {
      "name": "windows-clang-debug",
      "configurePreset": "windows-clang",
      "configuration": "Debug"
    },
    {
      "name": "windows-clang-release",
      "configurePreset": "windows-clang",
      "configuration": "Release"
    },
    {
      "name": "windows-clang-tests",
      "inherits": "windows-clang-debug",
      "targets": [
        "RodEngineTests"
      ]
    },
    {
      "name": "linux-clang-debug",
      "configurePreset": "linux-clang",
      "configuration": "Debug"
    },
    {
      "name": "linux-clang-release",
      "configurePreset": "linux-clang",
      "configuration": "Release"
    },
    {
      "name": "linux-clang-tests",
      "inherits": "linux-clang-debug",
      "targets": [
        "RodEngineTests"
      ]
    },
    {
      "name": "linux-clang-sanitizers",
      "configurePreset": "linux-clang-sanitizers",
      "configuration": "Debug"
    },
    {
      "name": "linux-clang-sanitizers-tests",
      "inherits": "linux-clang-sanitizers",
      "targets": [
        "RodEngineTests"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "${sourceDir}/build/test-results-${presetName}.xml"
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "vs-debug",
      "inherits": "test-base",
      "configurePreset": "vs",
      "configuration": "Debug"
    },
    {
      "name": "vs-release",
      "inherits": "test-base",
      "configurePreset": "vs",
      "configuration": "Release"
    },
    {
      "name": "vs-tests",
      "inherits": "vs-debug"
    },
    {
      "name": "windows-clang-debug",
      "inherits": "test-base",
      "configurePreset": "windows-clang",
      "configuration": "Debug"
    },
    {
      "name": "windows-clang-release",
      "inherits": "test-base",
      "configurePreset": "windows-clang",
      "configuration": "Release"
    },
    {
      "name": "windows-clang-tests",
      "inherits": "windows-clang-debug"
    },
    {
      "name": "linux-clang-debug",
      "inherits": "test-base",
      "configurePreset": "linux-clang",
      "configuration": "Debug"
    },
    {
      "name": "linux-clang-release",
      "inherits": "test-base",
      "configurePreset": "linux-clang",
      "configuration": "Release"
    },
    {
      "name": "linux-clang-tests",
      "inherits": "linux-clang-debug"
    },
    {
      "name": "linux-clang-sanitizers",
      "inherits": "test-base",
      "configurePreset": "linux-clang-sanitizers",
      "configuration": "Debug"
    }
  ],
  "workflowPresets": [
    {
      "name": "vs-debug",
      "displayName": "vs / Debug: build and test",
      "steps": [
        { "type": "configure", "name": "vs" },
        { "type": "build", "name": "vs-debug" },
        { "type": "test", "name": "vs-debug" }
      ]
    },
    {
      "name": "vs-release",
      "displayName": "vs / Release: build and test",
      "steps": [
        { "type": "configure", "name": "vs" },
        { "type": "build", "name": "vs-release" },
        { "type": "test", "name": "vs-release" }
      ]
    },
    {
      "name": "vs-tests",
      "displayName": "vs: Debug tests only",
      "steps": [
        { "type": "configure", "name": "vs" },
        { "type": "build", "name": "vs-tests" },
        { "type": "test", "name": "vs-tests" }
      ]
    },
    {
      "name": "windows-clang-debug",
      "displayName": "windows-clang / Debug: build and test",
      "steps": [
        { "type": "configure", "name": "windows-clang" },
        { "type": "build", "name": "windows-clang-debug" },
        { "type": "test", "name": "windows-clang-debug" }
      ]
    },
    {
      "name": "windows-clang-release",
      "displayName": "windows-clang / Release: build and test",
      "steps": [
        { "type": "configure", "name": "windows-clang" },
        { "type": "build", "name": "windows-clang-release" },
        { "type": "test", "name": "windows-clang-release" }
      ]
    },
    {
      "name": "windows-clang-tests",
      "displayName": "windows-clang: Debug tests only",
      "steps": [
        { "type": "configure", "name": "windows-clang" },
        { "type": "build", "name": "windows-clang-tests" },
        { "type": "test", "name": "windows-clang-tests" }
      ]
    },
    {
      "name": "linux-clang-debug",
      "displayName": "linux-clang / Debug: build and test",
      "steps": [
        { "type": "configure", "name": "linux-clang" },
        { "type": "build", "name": "linux-clang-debug" },
        { "type": "test", "name": "linux-clang-debug" }
      ]
    },
    {
      "name": "linux-clang-release",
      "displayName": "linux-clang / Release: build and test",
      "steps": [
        { "type": "configure", "name": "linux-clang" },
        { "type": "build", "name": "linux-clang-release" },
        { "type": "test", "name": "linux-clang-release" }
      ]
    },
    {
      "name": "linux-clang-tests",
      "displayName": "linux-clang: Debug tests only",
      "steps": [
        { "type": "configure", "name": "linux-clang" },
        { "type": "build", "name": "linux-clang-tests" },
        { "type": "test", "name": "linux-clang-tests" }
      ]
    },
    {
      "name": "linux-clang-sanitizers",
      "displayName": "Linux / Clang: Debug tests with sanitizers",
      "steps": [
        { "type": "configure", "name": "linux-clang-sanitizers" },
        { "type": "build", "name": "linux-clang-sanitizers-tests" },
        { "type": "test", "name": "linux-clang-sanitizers" }
      ]
    }
  ]
}
