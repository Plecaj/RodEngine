{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs",
      "displayName": "Visual Studio MSVC",
      "description": "MSVC-first configuration for Visual Studio development.",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "toolset": "host=x64",
      "binaryDir": "${sourceDir}/build/vs",
      "cacheVariables": {
        "ROD_CXX_STANDARD": "23",
        "ROD_BUILD_EDITOR": "ON"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": "Windows",
          "intelliSenseMode": "windows-msvc-x64",
          "enableMicrosoftCodeAnalysis": true,
          "intelliSenseOptions": {
            "useCompilerDefaults": true
          }
        }
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-clang",
      "displayName": "Windows Clang",
      "description": "Clang with the MSVC toolchain.",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/clang",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ROD_CXX_STANDARD": "23"
      }
    },
    {
      "name": "linux-clang",
      "displayName": "Linux Clang",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/clang",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ROD_CXX_STANDARD": "23",
        "GLFW_BUILD_X11": "ON",
        "GLFW_BUILD_WAYLAND": "OFF"
      }
    },
    {
      "name": "windows-clang-analysis",
      "displayName": "Windows Clang Debug Analysis",
      "inherits": "windows-clang",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/analysis",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_DISABLE_PRECOMPILE_HEADERS": "OFF",
        "BUILD_TESTING": "ON",
        "ROD_BUILD_EDITOR": "ON",
        "ROD_BUILD_RUNTIME": "ON"
      }
    },
    {
      "name": "linux-clang-analysis",
      "displayName": "Linux Clang Debug Analysis",
      "inherits": "linux-clang",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/analysis",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_DISABLE_PRECOMPILE_HEADERS": "OFF",
        "BUILD_TESTING": "ON",
        "ROD_BUILD_EDITOR": "ON",
        "ROD_BUILD_RUNTIME": "ON"
      }
    },
    {
      "name": "vs-tests",
      "displayName": "MSVC Unit Tests",
      "inherits": "vs",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "ROD_BUILD_EDITOR": "OFF",
        "ROD_BUILD_RUNTIME": "OFF"
      }
    },
    {
      "name": "windows-clang-tests",
      "displayName": "Windows Clang Unit Tests",
      "inherits": "windows-clang",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "ROD_BUILD_EDITOR": "OFF",
        "ROD_BUILD_RUNTIME": "OFF"
      }
    },
    {
      "name": "linux-clang-tests",
      "displayName": "Linux Clang Unit Tests",
      "inherits": "linux-clang",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "ROD_BUILD_EDITOR": "OFF",
        "ROD_BUILD_RUNTIME": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs-debug",
      "displayName": "VS Debug",
      "configurePreset": "vs",
      "configuration": "Debug",
      "targets": [
        "Rod-Editor"
      ]
    },
    {
      "name": "vs-release",
      "displayName": "VS Release",
      "configurePreset": "vs",
      "configuration": "Release",
      "targets": [
        "Rod-Editor"
      ]
    },
    {
      "name": "vs-dist",
      "displayName": "VS Dist",
      "configurePreset": "vs",
      "configuration": "Dist",
      "targets": [
        "Rod-Editor"
      ]
    },
    {
      "name": "windows-clang-debug",
      "displayName": "Windows Clang Debug",
      "configurePreset": "windows-clang",
      "configuration": "Debug"
    },
    {
      "name": "windows-clang-release",
      "displayName": "Windows Clang Release",
      "configurePreset": "windows-clang",
      "configuration": "Release"
    },
    {
      "name": "windows-clang-dist",
      "displayName": "Windows Clang Dist",
      "configurePreset": "windows-clang",
      "configuration": "Dist"
    },
    {
      "name": "linux-clang-debug",
      "displayName": "Linux Clang Debug",
      "configurePreset": "linux-clang",
      "configuration": "Debug"
    },
    {
      "name": "linux-clang-release",
      "displayName": "Linux Clang Release",
      "configurePreset": "linux-clang",
      "configuration": "Release"
    },
    {
      "name": "linux-clang-dist",
      "displayName": "Linux Clang Dist",
      "configurePreset": "linux-clang",
      "configuration": "Dist"
    },
    {
      "name": "vs-tests",
      "configurePreset": "vs-tests",
      "configuration": "Debug",
      "targets": ["RodEngineTests"]
    },
    {
      "name": "windows-clang-tests",
      "configurePreset": "windows-clang-tests",
      "configuration": "Debug",
      "targets": ["RodEngineTests"]
    },
    {
      "name": "linux-clang-tests",
      "configurePreset": "linux-clang-tests",
      "configuration": "Debug",
      "targets": ["RodEngineTests"]
    }
  ],
  "testPresets": [
    {
      "name": "vs-tests",
      "configurePreset": "vs-tests",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "${sourceDir}/build/${presetName}/test-results.xml"
      },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "windows-clang-tests",
      "configurePreset": "windows-clang-tests",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "${sourceDir}/build/${presetName}/test-results.xml"
      },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "linux-clang-tests",
      "configurePreset": "linux-clang-tests",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "${sourceDir}/build/${presetName}/test-results.xml"
      },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
